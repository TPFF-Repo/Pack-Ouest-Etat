        updateFn = function(params)
            local result = {}
            result.models = { }
            local grad = 0
            local height = 0
            local shiftm = 0
            local spacingm = 0
            local offsetz = intRange(-500, 500, 5)[params.offsetz+1]/100
            local offsety = intRange(-500, 500, 5)[params.offsety+1]/100
            local offsetx = intRange(-500, 500, 5)[params.offsetx+1]/100
            local zRotate = degrees[params.zRotate+1]            



             -- Règle la valeur d'espacement de l'asset
            if params.position == 0 then shiftm = -5 end
            if params.position == 0 then height = 1.95 end
            if params.position == 1 then shiftm = 5 end
            if params.position == 1 then height = 1.95 end

            if params.model_abri == 0 then 
                result.models = {{id = "assets/empty.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
            elseif params.model_abri == 1 then
                if params.model_assets == 0 then
                    result.models = {{id = "assets/abri_quai/abri_ouest_1/abri_ouest_1.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 1 then
                    result.models = {{id = "assets/abri_quai/abri_ouest_1/abri_ouest_1_p.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 2 then    
                    result.models = {{id = "assets/abri_quai/abri_ouest_1/abri_ouest_1_pvd.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                end   
            elseif params.model_abri == 2 then
                if params.model_assets == 0 then
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_2.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 1 then
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_2_p.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 2 then    
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_2_pvd.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                end  
            elseif params.model_abri == 3 then
                if params.model_assets == 0 then
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_3.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 1 then
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_3_p.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 2 then    
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_3_pvd.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                end  
            elseif params.model_abri == 4 then
                if params.model_assets == 0 then
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_4.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 1 then
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_4_p.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                elseif params.model_assets == 2 then    
                    result.models = {{id = "assets/abri_quai/abri_ouest/abri_ouest_4_pvd.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
                end  
            end 

            

            result.terrainAlignmentLists = { { type = "EQUAL", faces = {} } }

            result.groundFaces = {
            	{
            	face = { { -0.01, -0.01, 0 }, { 0.01, -0.01, 0 }, { 0.01, 0.01, 0 } },
            	modes = {
            		{
            		  type = "FILL",
            		  key = "industry_floor.lua"
            		}
            	},
            	loop = true,
            	alignmentOffsetMode = "OBJECT",
            	alignmentDirMode = "OBJECT",
            	alignmentOffset = { -2.0, -1.0 },
            	},
            }
            return result

        end
    }
end