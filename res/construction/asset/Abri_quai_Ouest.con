local vec3 = require "vec3"
local transf = require "transf"

local function map(a, f)
	local res = {}
	if a and type(a) =="table" then
		for _, v in ipairs(a) do
			table.insert(res, f(v))
		end
	end
	return res
end

local function intRange(start, stop, step)
	local a = {}
	local i = start
	while i <= stop do
		table.insert(a, i)
		i = i + step
	end
	return a
end

local degrees = intRange(-180,180, 1)

function data()
    return {
        type = "ASSET_TRACK",
        buildMode = "MULTI",
        description = {
            name = _("Abri de Quai Ouest"),
            icon = "ui/construction/asset/abri_quai_ouest.tga",
            description = _("Abri Configurable. Pour changer les textes format: Gare/Quai/Destination")
        },
        categories = {"Gares Ouest-Etat"},
        skipCollision = true,--false,
        autoRemovable = false,
        order = 4406,
        params = {
            {
                key = "model_abri",
                name = _("Model Abri"),
                uiType = "ICON_BUTTON",
                values = {
                    _("ui/parameters/none.tga"),
                    _("ui/parameters/abri_ouest/abri_type_1.tga"),
                    _("ui/parameters/abri_ouest/abri_type_2.tga"),
                    _("ui/parameters/abri_ouest/abri_type_3.tga"),
                    _("ui/parameters/abri_ouest/abri_type_4.tga"),
                },
