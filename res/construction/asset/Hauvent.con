local vec3 = require "vec3"
local transf = require "transf"

local function map(a, f)
	local res = {}
	if a and type(a) =="table" then
		for _, v in ipairs(a) do
			table.insert(res, f(v))
		end
	end
	return res
end

local function intRange(start, stop, step)
	local a = {}
	local i = start
	while i <= stop do
		table.insert(a, i)
		i = i + step
	end
	return a
end
local degrees = intRange(-180,180, 1)

local hauventModel = {
    "assets/hauvent/hauvent_1.mdl",
}

function data()
    return {
        type = "ASSET_TRACK",
        buildMode = "MULTI",
        description = {
            name = _("Hauvent"),
            icon = "ui/construction/asset/hauvent.tga"
        },
        categories = {"Gares Ouest-Etat"},
        skipCollision = true,--false,
        autoRemovable = false,
        order = 4404+10,
        params = {
            {
                key = "model_hauvent",
                name = _("Hauvent"),
                uiType = "ICON_BUTTON",
                values = {
                    _("ui/parameters/none.tga"),                
                    _("ui/parameters/hauvent/hauvent_1.tga"),
                },
                defaultIndex = 0,
            },
            {
                key = "model_panneauVoie",
                name = _("Panneau de Voie"),
                uiType = "BUTTON",
                values = {
                    _("Aucun"),
                    _("Voie"),
                    _("Repère"),
                    _("Destination"),
                },
                defaultIndex = 0,
            },
            {
                key = "model_panneauGare",
                name = _("Panneau de Gare"),
                uiType = "BUTTON",
                values = {
                    _("Aucun"),
                    _("Simple"),                    
                },
                defaultIndex = 0,
            },
            {
                key = "model_lamp",
                name = _("Lamp de quai"),
                uiType = "BUTTON",
                values = {
                    _("Non"),
                    _("Oui"),                    
                },
                defaultIndex = 0,
            },
            {
                key = "model_props",
                name = _("Objets de quai"),
                uiType = "BUTTON",
                values = {
                    _("Non"),
                    _("Oui"),                    
                },
                defaultIndex = 0,
            },
            {
            	key = "position",
            	name = _("Position"), --translate on string.lua
            	uiType = "BUTTON",
            	values = { _("Gauche"), _("Droite") },
            	tooltip = _(""),
            	defaultIndex = 0,
            },
            {
            	key = "offsetz",
            	name = _("Hauteur"),
            	values = map(intRange(-500, 500, 5), function(i) return ""..i.." cm"  end),
            	uiType = "SLIDER",
            	defaultIndex = math.floor(#intRange(-500, 500, 5)/2)
            },
            {
            	key = "offsety",
            	name = _("Distance de la voie"),
            	values = map(intRange(-500, 500, 5), function(i) return ""..i.." cm"  end),
            	uiType = "SLIDER",
            	defaultIndex = math.floor(#intRange(-500, 500, 5)/2)
            },
            {
            	key = "offsetx",
            	name = _("Espacement"),
            	values = map(intRange(-500, 500, 5), function(i) return ""..i.." cm"  end),
            	uiType = "SLIDER",
            	defaultIndex = math.floor(#intRange(-500, 500, 5)/2)
            },
            {
                key = "zRotate",
                name = _("Rotation Z"),
                values = map(degrees, function(i) return ""..i.." °"  end),
                uiType = "SLIDER",
                defaultIndex = math.floor(#degrees/2),
            },
        },
        updateFn = function (params)
            local result = {}
            result.models = { }
            local grad = 0
            local height = 0
            local shiftm = 0
            local spacingm = 0
            local offsetz = intRange(-500, 500, 5)[params.offsetz+1]/100
            local offsety = intRange(-500, 500, 5)[params.offsety+1]/100
            local offsetx = intRange(-500, 500, 5)[params.offsetx+1]/100
            local zRotate = degrees[params.zRotate+1]  
            local inverRotate = degrees[params.zRotate+1-180]
            local zRotate90 = degrees[params.zRotate+1+90]
            local zRotateInvert90 = degrees[(params.zRotate+1)-(-90)]

            if params.position == 0 then shiftm = -5 end
            if params.position == 0 then height = 1.95 end
            if params.position == 1 then shiftm = 5 end
            if params.position == 1 then height = 1.95 end

            if (params.model_hauvent == 0) then
                result.models = {{id = "assets/empty.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}}
            elseif params.model_hauvent == 1 then                
                -- Panneau de Voie
                if params.model_panneauVoie == 1 then
                    if params.model_panneauGare == 1 then
                        result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_pv_name.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    else
                        result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_pv_empty.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    end
                elseif params.model_panneauVoie == 2 then
                    if params.model_panneauGare == 1 then
                        result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_pr_name.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    else
                        result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_pr_empty.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    end
                elseif params.model_panneauVoie == 3 then
                    if params.model_panneauGare == 1 then
                        result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_pd_name.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    else
                        result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_pd_empty.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    end
                else 
                    result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_empty.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                end

                if params.model_lamp == 1 then
                    result.models[#result.models + 1] = {id = "assets/hauvent/hauvent_1/hauvent_1_lamp.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                end

                if params.model_props == 1 then
                    -- Horloges
                    result.models[#result.models + 1] = {id = "assets/props/horloges/horloge_murale_sncf_bodet_carmillon.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate, 0, grad), vec3.new(spacingm+offsetx-5, shiftm+offsety+0.69, height+offsetz-0.3))}
                    result.models[#result.models + 1] = {id = "assets/props/horloges/horloge_murale_sncf_bodet_carmillon.mdl", transf = transf.rotZYXTransl(transf.degToRad(inverRotate, 0, grad), vec3.new(spacingm+offsetx-5, shiftm+offsety-0.69, height+offsetz-0.3))}

                    -- Support Ecrans
                    result.models[#result.models + 1] = {id = "assets/props/support_ecran_left.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotate90, 0, grad), vec3.new(spacingm+offsetx+10, shiftm+offsety, height+offsetz-0.5))}
                    result.models[#result.models + 1] = {id = "assets/props/support_ecran_right.mdl", transf = transf.rotZYXTransl(transf.degToRad(zRotateInvert90, 0, grad), vec3.new(spacingm+offsetx+10, shiftm+offsety, height+offsetz-0.5))}
                end


            end
            result.terrainAlignmentLists = { { type = "EQUAL", faces = {} } }

            result.groundFaces = {
            	{
            	face = { { -0.01, -0.01, 0 }, { 0.01, -0.01, 0 }, { 0.01, 0.01, 0 } },
            	modes = {
            		{
            		  type = "FILL",
            		  key = "industry_floor.lua"
            		}
            	},
            	loop = true,
            	alignmentOffsetMode = "OBJECT",
            	alignmentDirMode = "OBJECT",
            	alignmentOffset = { -2.0, -1.0 },
            	},
            }
            return result
        end
    }
end

