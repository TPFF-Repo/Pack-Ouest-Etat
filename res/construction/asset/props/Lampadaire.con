local vec3 = require "vec3"
local transf = require "transf"

local function map(a, f)
	local res = {}
	if a and type(a) =="table" then
		for _, v in ipairs(a) do
			table.insert(res, f(v))
		end
	end
	return res
end

local function intRange(start, stop, step)
	local a = {}
	local i = start
	while i <= stop do
		table.insert(a, i)
		i = i + step
	end
	return a
end
local degrees = intRange(-180,180, 1)

local lampModel = {
    "assets/props/lampadaires/lampadaire_generique_ouest.mdl",
    "assets/props/lampadaires/lampadaire_double_generique_ouest.mdl",
    "assets/props/lampadaires/lampadaire_la_forest.mdl",
}

local panneauOneModel = {
    "assets/empty.mdl",
    "assets/panneau_indicateur/panneau_indicateur_sortie_simple.mdl",
}

local panneauTwoModel = {
    "assets/empty.mdl",
    "assets/panneau_indicateur/panneau_indicateur_dir_both.mdl",
    "assets/panneau_indicateur/panneau_indicateur_train.mdl",
}

local panneauTreeModel = {
    "assets/empty.mdl",
    "assets/panneau_avertissement/panneau_aver_traverse.mdl",
    "assets/panneau_avertissement/panneau_interdit_yellow.mdl",
}

local panneauFourModel = {
    "assets/empty.mdl",
    "assets/panneau/panneau_sncf_fr_fr_bleu.mdl",
}

local panneauFiveModel = {
    "assets/empty.mdl",
    "assets/panneau_voie/panneau_voie_simple.mdl",
    "assets/panneau_voie/panneau_voie_both.mdl",
}

function data()
    return {
        type = "ASSET_TRACK",
        buildMode = "MULTI",
        description = {
            name = _("Lampadaire"),
            icon = "ui/construction/asset/Lampadaire.tga"
        },
        categories = {"Gares Ouest-Etat"},
        skipCollision = true,--false,
        autoRemovable = false,
        order = 4404,
        params = {
            {
                key = "model_lamp",
                name = _("Lampadaire"),
                uiType = "COMBOBOX",
                values = {
                    _("Lampadaire Générique Ouest"),
                    _("Lampadaire Générique Ouest Double"),
                    _("Lampadaire La Forest"),
                },
                defaultIndex = 0,
            },
            {
                key = "model_panneau_1",
                name = _("Panneau Supplémentaire 1"),
                uiType = "ICON_BUTTON",
                values = {
                    _("ui/parameters/panneau/none.tga"),
                    _("ui/parameters/panneau/panneau_sortie.tga"),
                },
                defaultIndex = 0,
            },
            {
                key = "model_panneau_2",
                name = _("Panneau Supplémentaire 2"),
                uiType = "ICON_BUTTON",
                values = {
                    _("ui/parameters/panneau/none.tga"),
                    _("ui/parameters/panneau/panneau_direction.tga"),
                    _("ui/parameters/panneau/panneau_train.tga"),
                },
                defaultIndex = 0,
            },
            {
            	key = "model_panneau_3",
            	name = _("Panneau Supplémentaire 3"),
            	uiType = "ICON_BUTTON",
            	values = {
            	    _("ui/parameters/panneau/none.tga"),
            	    _("ui/parameters/panneau/panneau_aver.tga"),
            	    _("ui/parameters/panneau/panneau_interdit.tga"),
            	 },
            	tooltip = _(""),
            	defaultIndex = 0,
            },
            {
            	key = "model_panneau_3_rotation",
            	name = _("Panneau 3 Rotation"),
            	values = { _("0°"), _("90°"), _("180°") },
            	uiType = "BUTTON",
            	defaultIndex = 0
            },
            {
            	key = "model_panneau_4",
            	name = _("Panneau Gare"),
            	uiType = "ICON_BUTTON",
            	values = {
            	    _("ui/parameters/panneau/none.tga"),
            	    _("ui/parameters/panneau/panneau_sncf_fr_fr_bleu.tga"),
            	 },
            	tooltip = _(""),
            	defaultIndex = 0,
            },
            {
            	key = "model_panneau_5",
            	name = _("Panneau Voie"),
            	uiType = "ICON_BUTTON",
            	values = {
            	    _("ui/parameters/panneau/none.tga"),
            	    _("ui/parameters/panneau_voie/simple.tga"),
            	    _("ui/parameters/panneau_voie/double.tga"),
            	 },
            	tooltip = _(""),
            	defaultIndex = 0,
            },
            {
            	key = "positiony_gare",
            	name = _("Position"), --translate on string.lua
            	uiType = "BUTTON",
            	values = { _("Gauche"), _("Droite") },
            	tooltip = _(""),
            	defaultIndex = 0,
            },
            {
            	key = "offsetz",
            	name = _("Hauteur"),
            	values = map(intRange(-500, 500, 5), function(i) return ""..i.." cm"  end),
            	uiType = "SLIDER",
            	defaultIndex = math.floor(#intRange(-500, 500, 5)/2)
            },
            {
            	key = "offsety",
            	name = _("Distance de la voie"),
            	values = map(intRange(-500, 500, 5), function(i) return ""..i.." cm"  end),
            	uiType = "SLIDER",
            	defaultIndex = math.floor(#intRange(-500, 500, 5)/2)
            },
            {
            	key = "offsetx",
            	name = _("Espacement"),
            	values = map(intRange(-500, 500, 5), function(i) return ""..i.." cm"  end),
            	uiType = "SLIDER",
            	defaultIndex = math.floor(#intRange(-500, 500, 5)/2)
            },
        },
        updateFn = function(params)
            local result = {}
            result.models = { }
            local modelLamp = lampModel[params.model_lamp+1]
            local modelOnePanneau = panneauOneModel[params.model_panneau_1+1]
            local modelTwoPanneau = panneauTwoModel[params.model_panneau_2+1]
            local modelTreePanneau = panneauTreeModel[params.model_panneau_3+1]
            local modelFourPanneau = panneauFourModel[params.model_panneau_4+1]
            local modelFivePanneau = panneauFiveModel[params.model_panneau_5+1]

            local grad = 0
            local height = 0
            local shiftm = 0
            local spacingm = 0
            local offsetz = intRange(-500, 500, 5)[params.offsetz+1]/100
            local offsety = intRange(-500, 500, 5)[params.offsety+1]/100
            local offsetx = intRange(-500, 500, 5)[params.offsetx+1]/100
            local rotTreePanneau = 0
            local shiftmTreePanneau = 0
            local spacinggmTreePanneau = 0

            if(params.model_panneau_3_rotation == 0) then
                rotTreePanneau = degrees[180]
                shiftmTreePanneau = -0.05
                spacinggmTreePanneau = 0
            elseif(params.model_panneau_3_rotation == 1) then
                rotTreePanneau = degrees[90]
                spacinggmTreePanneau = -0.05
                shiftmTreePanneau = 0
            else 
                rotTreePanneau = degrees[0]
                spacinggmTreePanneau = -0.05
                shiftmTreePanneau = 0
            end


             -- Règle la valeur d'espacement de l'asset
            if params.positiony_gare == 0 then shiftm = -5 end
            if params.positiony_gare == 0 then height = 1.3 end
            if params.positiony_gare == 1 then shiftm = 5 end
            if params.positiony_gare == 1 then height = 1.3 end

            if params.model_lamp == 0 or params.model_lamp == 1 then
                result.models[#result.models + 1] = {id=modelLamp, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                result.models[#result.models + 1] = {id=modelOnePanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety+(-0.01), height+offsetz))}
                if params.model_panneau_2 == 0 then
                    result.models[#result.models + 1] = {id=modelTwoPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                elseif params.model_panneau_2 == 1 then
                    result.models[#result.models + 1] = {id=modelTwoPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                elseif params.model_panneau_2 == 2 then
                    result.models[#result.models + 1] = {id=modelTwoPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety+(-0.03), height+offsetz))}
                end
                result.models[#result.models + 1] = {id=modelTreePanneau, transf = transf.rotZYXTransl(transf.degToRad(rotTreePanneau,0,0), vec3.new(spacingm+offsetx+(spacinggmTreePanneau), shiftm+offsety+(shiftmTreePanneau), height+offsetz+2.3))}
                result.models[#result.models + 1] = {id=modelFivePanneau, transf = transf.rotZYXTransl(transf.degToRad(degrees[270],0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz+2.3))}
                result.models[#result.models + 1] = {id=modelFourPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety+(-0.05), height+offsetz+2))}
            elseif params.model_lamp == 2 then
                result.models[#result.models + 1] = {id=modelLamp, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz+0.5))}
                result.models[#result.models + 1] = {id=modelOnePanneau, transf = transf.rotZYXTransl(transf.degToRad(degrees[270],0,0), vec3.new(spacingm+offsetx, shiftm+offsety+(-0.01), height+offsetz))}
                    if params.model_panneau_2 == 0 then
                        result.models[#result.models + 1] = {id=modelTwoPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    elseif params.model_panneau_2 == 1 then
                        result.models[#result.models + 1] = {id=modelTwoPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz))}
                    elseif params.model_panneau_2 == 2 then
                        result.models[#result.models + 1] = {id=modelTwoPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety+(-0.03), height+offsetz))}
                    end
                result.models[#result.models + 1] = {id=modelTreePanneau, transf = transf.rotZYXTransl(transf.degToRad(rotTreePanneau,0,0), vec3.new(spacingm+offsetx+(spacinggmTreePanneau), shiftm+offsety+(shiftmTreePanneau), height+offsetz+2.3))}
                result.models[#result.models + 1] = {id=modelFivePanneau, transf = transf.rotZYXTransl(transf.degToRad(degrees[270],0,0), vec3.new(spacingm+offsetx, shiftm+offsety, height+offsetz+2.3))}
                result.models[#result.models + 1] = {id=modelFourPanneau, transf = transf.rotZYXTransl(transf.degToRad(0,0,0), vec3.new(spacingm+offsetx, shiftm+offsety+(-0.05), height+offsetz+2))}
            end



            result.terrainAlignmentLists = { { type = "EQUAL", faces = {} } }

            result.groundFaces = {
            	{
            	face = { { -0.01, -0.01, 0 }, { 0.01, -0.01, 0 }, { 0.01, 0.01, 0 } },
            	modes = {
            		{
            		  type = "FILL",
            		  key = "industry_floor.lua"
            		}
            	},
            	loop = true,
            	alignmentOffsetMode = "OBJECT",
            	alignmentDirMode = "OBJECT",
            	alignmentOffset = { -2.0, -1.0 },
            	},
            }


            return result

        end
    }
end